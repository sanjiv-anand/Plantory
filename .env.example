# Global
COMPOSE_PROJECT_NAME=lilylog

# PostgreSQL
POSTGRES_DB=lilylog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg:///lilylog?host=postgres&user=postgres
APP_NAME=LILYLOG
ENVIRONMENT=production
CORS_ORIGINS=["http://localhost:4173","http://localhost:5173"]
PHOTOS_ROOT=/data/photos
PHOTOS_PUBLIC_BASE=/media
MAX_UPLOAD_MB=15
THUMBNAIL_SIZE=320
DISPLAY_MAX_WIDTH=1920
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=10
BACKUP_DIR=/data/backups
BACKUP_HOST_DIR=~/lilylog-backups
BACKUP_RETENTION_DAYS=14
BACKUP_INCLUDE_MODELS=true
SECRET_KEY=change-me-in-production
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=LILYLOG
WEBAUTHN_ORIGIN=http://localhost:4173

# App port exposed to Tailscale Serve (backend serves UI + API on one port)
GATEWAY_PORT=4173

# Frontend build-time URLs (same-origin; baked into the backend image)
VITE_API_URL=/api
VITE_MEDIA_URL=

# Local AI (llama.cpp)
LLM_ENABLED=true
LLM_BASE_URL=http://llm:8080
LLM_MODEL=qwen3-0.6b
LLM_MODEL_PATH=/models/Qwen_Qwen3-0.6B-Q4_K_M.gguf
LLM_MODEL_DISPLAY_NAME=Qwen3-0.6B
LLM_TIMEOUT_SECONDS=60
LLM_HEALTH_TIMEOUT_SECONDS=5
LLM_MAX_TOKENS=256
LLM_TEMPERATURE=0.45
LLM_MAX_CONCURRENT_REQUESTS=1
LLM_CONTEXT_SIZE=2048
LLM_THREADS=4
LLM_PARALLEL=1
AI_ASSISTANT_ENABLED=true
AI_DAILY_SUMMARY_ENABLED=false
AI_STORY_ENABLED=true
