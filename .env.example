# Global
COMPOSE_PROJECT_NAME=lilylog

# PostgreSQL
POSTGRES_DB=lilylog
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Backend
BACKEND_PORT=8000
DATABASE_URL=postgresql+psycopg:///lilylog?host=postgres&user=postgres
APP_NAME=LILYLOG
ENVIRONMENT=production
CORS_ORIGINS=["http://localhost:4173","http://localhost:5173"]
PHOTOS_ROOT=/data/photos
PHOTOS_PUBLIC_BASE=/media
MAX_UPLOAD_MB=15
THUMBNAIL_SIZE=320
DISPLAY_MAX_WIDTH=1920
WEATHER_API_URL=https://api.open-meteo.com/v1/forecast
WEATHER_TIMEOUT_SECONDS=10
BACKUP_DIR=/data/backups

# Frontend
FRONTEND_PORT=4173
VITE_API_URL=http://localhost:8000/api
VITE_MEDIA_URL=http://localhost:8000
